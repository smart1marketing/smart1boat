# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Smart 1 Suite / HighLevel inbound webhook
SMART1_SUITE_WEBHOOK_URL=https://your-smart-1-suite-webhook-url

# CORS: comma-separated list of allowed origins. Blank = allow all (testing only).
ALLOWED_ORIGINS=http://localhost:3000

NODE_ENV=development

# --- Optional: one-time Smart 1 Suite custom field creation ---
GHL_LOCATION_ID=
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_API_VERSION=v3
SUITE_FIELD_DRY_RUN=true
SUITE_SKIP_EXISTING=true
